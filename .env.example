# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Z-Library Configuration (bipinkrish/Zlibrary-API & sertraline/zlibrary)
# Option 1: Authenticate with Email & Password
ZLIB_EMAIL=
ZLIB_PASSWORD=

# Option 2: Authenticate with Token / Cookies (remix_userkey & remix_userid)
REMIX_USERKEY=
REMIX_USERID=

# Temporary download storage directory
DOWNLOAD_CACHE_DIR=./downloads

# Calibre ebook-convert path (optional, leave default if calibre is in PATH)
CALIBRE_CONVERT_PATH=ebook-convert
